# b-sandbox (sandbox service for b-superagent), served under the {{BASE_PATH}} prefix.
#
# Host port 80 is iteach's catch-all; /api/ belongs to iteach, /eval/ to
# b-eval, /b-superagent/ to b-superagent. b-sandbox takes its own prefix and
# port 8094 (co-tenant plan: iteach 8080, b-eval 8091, b-superagent 8093).
#
# The trailing slash on proxy_pass strips the prefix: the container sees
# /health, exactly as in a root deployment.

location = {{BASE_PATH}} {
    return 301 {{BASE_PATH}}/;
}

location {{BASE_PATH}}/ {
    proxy_pass http://127.0.0.1:8094/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Workload execs run up to the 600s timeout ceiling; the proxy must be
    # more patient than the longest request it forwards.
    proxy_connect_timeout 10s;
    proxy_send_timeout    700s;
    proxy_read_timeout    700s;
}
